{
  "version": 1,
  "kind": "visual",
  "id": "project-workbench",
  "name": "Project workbench",
  "description": "Compact project work with visible progress, usage and native navigation.",
  "author": "Project UAI",
  "sources": [{"label":"Project UAI UI mods guide","url":"https://github.com/Project-Ptolemy/ProjectUAI/blob/main/docs/UI_MODS.md"}],
  "appearance": {
    "accent": "indigo",
