<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UAI Bridge</AssemblyName>
    <Product>UAI Bridge</Product>
    <Description>One-click Cowork launcher for Project UAI</Description>
    <Version>3.8.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup Condition="'$(BridgePayload)' != ''">
    <EmbeddedResource Include="$(BridgePayload)" LogicalName="ProjectUai.Payload.zip" />
  </ItemGroup>
</Project>
